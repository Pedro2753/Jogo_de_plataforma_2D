; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Singular Mount"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/image="res://assets/images/Singular Mount  Banner.png"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=3000

[autoload]

DialogManager="*res://singletons/dialog_manager.gd"
Music="*res://scenes/music.tscn"

[display]

window/stretch/scale=0.5
window/stretch/scale_mode="integer"

[global_group]

Persist=""
fireball=""

